diff --git a/ios/HEXShared/FullKeyboard/PinyinComposition.swift b/ios/HEXShared/FullKeyboard/PinyinComposition.swift
new file mode 100644
index 0000000..6cdec92
--- /dev/null
+++ b/ios/HEXShared/FullKeyboard/PinyinComposition.swift
@@ -0,0 +1,163 @@
+import Foundation
+
+struct PinyinComposition {
+    private let lexicon: PinyinLexicon?
+    private(set) var spelling = ""
+    private(set) var candidates: [String] = []
+
+    init(lexicon: PinyinLexicon? = nil) {
+        self.lexicon = lexicon
+    }
+
+    var isActive: Bool { !spelling.isEmpty }
+
+    @discardableResult
+    mutating func append(_ key: String) -> Bool {
+        let letter = key.lowercased().replacingOccurrences(of: "ü", with: "v")
+        guard letter.utf8.count == 1, spelling.utf8.count < 48 else { return false }
+        if letter == "'" {
+            guard isActive, spelling.last != "'" else { return false }
+        } else {
+            guard let byte = letter.utf8.first, (97...122).contains(byte) else { return false }
+        }
+        spelling += letter
+        updateCandidates()
+        return true
+    }
+
+    @discardableResult
+    mutating func deleteBackward() -> Bool {
+        guard isActive else { return false }
+        spelling.removeLast()
+        updateCandidates()
+        return true
+    }
+
+    mutating func commit(_ candidate: String? = nil) -> String? {
+        guard isActive else { return nil }
+        if let candidate, !candidates.contains(candidate) { return nil }
+        let output = candidate ?? candidates.first ?? spelling
+        reset()
+        return output
+    }
+
+    mutating func reset() {
+        spelling = ""
+        candidates = []
+    }
+
+    private mutating func updateCandidates() {
+        candidates = isActive ? (lexicon ?? .bundled).candidates(for: spelling) : []
+    }
+}
+
+struct PinyinLexicon: Sendable {
+    private struct Entry: Sendable {
+        let text: String
+        let weight: Int
+        let syllableBreaks: [Int]
+    }
+
+    private struct Reading {
+        var letters: [UInt8] = []
+        var syllableBreaks: [Int] = []
+
+        init(_ spelling: String) {
+            for byte in spelling.lowercased().replacingOccurrences(of: "ü", with: "v").utf8 {
+                if (97...122).contains(byte) {
+                    letters.append(byte)
+                } else if byte == 32 || byte == 39 {
+                    if !letters.isEmpty, syllableBreaks.last != letters.count {
+                        syllableBreaks.append(letters.count)
+                    }
+                }
+            }
+        }
+
+        var key: String { String(decoding: letters, as: UTF8.self) }
+    }
+
+    private struct Match {
+        let text: String
+        let pieces: Int
+        let score: Double
+
+        func ranksBefore(_ other: Match) -> Bool {
+            if pieces != other.pieces { return pieces < other.pieces }
+            if score != other.score { return score > other.score }
+            return text < other.text
+        }
+    }
+
+    static let bundled: PinyinLexicon = {
+        let bundles = [Bundle(for: PinyinResource.self), Bundle.main]
+        for bundle in bundles {
+            if let url = bundle.url(forResource: "PinyinLexicon", withExtension: "tsv"),
+               let tsv = try? String(contentsOf: url, encoding: .utf8) {
+                return PinyinLexicon(tsv: tsv)
+            }
+        }
+        return PinyinLexicon(tsv: "")
+    }()
+
+    private let entries: [String: [Entry]]
+    private let longestReading: Int
+
+    init(tsv: String) {
+        var entries: [String: [Entry]] = [:]
+        var longestReading = 0
+        for line in tsv.split(whereSeparator: \.isNewline) where !line.hasPrefix("#") {
+            let columns = line.split(separator: "\t", omittingEmptySubsequences: false)
+            guard columns.count == 3, !columns[1].isEmpty, let weight = Int(columns[2]), weight >= 0 else {
+                continue
+            }
+            let reading = Reading(String(columns[0]))
+            guard !reading.letters.isEmpty else { continue }
+            entries[reading.key, default: []].append(Entry(
+                text: String(columns[1]), weight: weight, syllableBreaks: reading.syllableBreaks
+            ))
+            longestReading = max(longestReading, reading.letters.count)
+        }
+        self.entries = entries.mapValues { group in
+            group.sorted { lhs, rhs in
+                if lhs.weight != rhs.weight { return lhs.weight > rhs.weight }
+                return lhs.text < rhs.text
+            }
+        }
+        self.longestReading = longestReading
+    }
+
+    func candidates(for spelling: String, limit: Int = 9) -> [String] {
+        let reading = Reading(spelling)
+        let length = reading.letters.count
+        guard length > 0, longestReading > 0, limit > 0 else { return [] }
+        var paths = [[Match]](repeating: [], count: length + 1)
+        paths[length] = [Match(text: "", pieces: 0, score: 0)]
+
+        for start in (0..<length).reversed() {
+            var matches: [Match] = []
+            for end in (start + 1)...min(length, start + longestReading) where !paths[end].isEmpty {
+                let key = String(decoding: reading.letters[start..<end], as: UTF8.self)
+                guard let words = entries[key] else { continue }
+                let explicitBreaks = reading.syllableBreaks.filter { start < $0 && $0 < end }
+                let allowed = words.lazy.filter { entry in
+                    explicitBreaks.allSatisfy { entry.syllableBreaks.contains($0 - start) }
+                }
+                for entry in allowed.prefix(limit) {
+                    let score = log1p(Double(entry.weight))
+                    for suffix in paths[end] {
+                        matches.append(Match(text: entry.text + suffix.text, pieces: suffix.pieces + 1, score: score + suffix.score))
+                    }
+                }
+            }
+            var seen: Set<String> = []
+            for match in matches.sorted(by: { $0.ranksBefore($1) }) where seen.insert(match.text).inserted {
+                paths[start].append(match)
+                if paths[start].count == limit { break }
+            }
+        }
+        return paths[0].map(\.text)
+    }
+}
+
+private final class PinyinResource: NSObject {}
